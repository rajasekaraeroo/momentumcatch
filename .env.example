# ── Upstox ────────────────────────────────────────────────────────────────
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3001/auth/upstox/callback

# ── Infrastructure ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://momentum:momentum@localhost:5432/momentumscan
REDIS_URL=redis://localhost:6379

# ── Engine ────────────────────────────────────────────────────────────────
ENGINE_PORT=3001
WEB_PORT=3000
TZ=Asia/Kolkata

# Record raw ticks to data/ticks/*.ndjson for replay (Track B validation)
RECORD_TICKS=true

# Optional Telegram alerts (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
